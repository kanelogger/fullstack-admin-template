{
  "name": "fullstack-admin-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "volta": {
    "node": "24.18.0",
    "pnpm": "12.3.4"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "@template/contracts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "deno": "2.9.6",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "3.8.3",
    "typescript-eslint": "^8.71.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter fullstack-admin-frontend build",
    "lint": "eslint . --max-warnings 0 && pnpm exec deno lint supabase/functions",
    "check:docs": "node scripts/check-docs.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:test-architecture": "node scripts/check-test-architecture.mjs",
    "check:migration-upgrades": "node scripts/check-migration-upgrades.mjs",
    "typecheck": "pnpm --filter fullstack-admin-frontend typecheck && pnpm --filter @template/contracts typecheck && node scripts/typecheck-edge-functions.mjs",
    "test:unit": "pnpm --filter fullstack-admin-frontend test:unit && pnpm --filter fullstack-admin-frontend test:components && pnpm exec deno test --quiet supabase/functions/_shared/http.test.ts && pnpm --filter @template/contracts test && node --test scripts/*.test.mjs",
    "test:browser": "pnpm --filter fullstack-admin-frontend test:browser",
    "test:components": "pnpm --filter fullstack-admin-frontend test:components",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "test:visual:update": "node scripts/run-visual-tests.mjs --update",
    "test:visual:accept": "node scripts/run-visual-tests.mjs --accept",
    "test:agent:start": "node scripts/agent-testing.mjs start",
    "test:agent:cleanup": "node scripts/agent-testing.mjs cleanup",
    "test:agent:fill": "node scripts/agent-testing.mjs fill",
    "test:agent:record": "node scripts/test-architecture.mjs record",
    "test:agent:verify": "node scripts/test-architecture.mjs verify",
    "test:browser:local": "pnpm --filter fullstack-admin-frontend test:browser:local",
    "test:db": "pnpm --filter fullstack-admin-frontend test:db",
    "setup:admin": "node scripts/setup-admin.mjs",
    "template:init": "node scripts/template-init.mjs",
    "template:select-migrations": "node scripts/template-migrations.mjs select",
    "template:sync-migrations": "node scripts/template-migrations.mjs sync",
    "check:migrations": "node scripts/check-migrations.mjs",
    "functions:serve": "pnpm --filter fullstack-admin-frontend exec supabase functions serve",
    "supabase:start": "node scripts/local-supabase-cli.mjs start",
    "supabase:stop": "node scripts/local-supabase-cli.mjs stop",
    "supabase:status": "node scripts/local-supabase-cli.mjs status",
    "supabase:db:reset": "pnpm --filter fullstack-admin-frontend run supabase:db:reset",
    "format": "prettier --write \"frontend/src/**/*.{vue,ts}\"",
    "format:check": "prettier --check \"frontend/src/**/*.{vue,ts}\""
  }
}
