{
  "name": "fullstack-admin-backend",
  "version": "0.1.0",
  "description": "全栈管理后台后端 API",
  "private": true,
  "packageManager": "npm@12.0.2",
  "volta": {
    "node": "24.18.0",
    "npm": "12.0.2"
  },
  "scripts": {
    "dev": "nodemon --config nodemon.json src/server.ts",
    "start": "nodemon --config nodemon.json src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test:migration:accounts": "node --test scripts/migrate-auth-accounts.test.mjs",
    "test:migration:organization": "node --test scripts/migrate-organization-to-supabase.test.mjs",
    "test:migration:dictionary-configuration": "node --test scripts/migrate-dictionary-configuration-to-supabase.test.mjs",
    "test:migration:attachments": "node --test scripts/migrate-attachments-to-supabase.test.mjs",
    "test:migration:audit-logs": "node --test scripts/migrate-audit-logs-to-supabase.test.mjs",
    "test:migration:menus": "node --test scripts/migrate-menus-to-supabase.test.mjs",
    "test:migration:messages": "node --test scripts/migrate-messages-to-supabase.test.mjs",
    "migrate:messages": "node scripts/migrate-messages-to-supabase.mjs",
    "migrate:organization": "node scripts/migrate-organization-to-supabase.mjs",
    "migrate:dictionary-configuration": "node scripts/migrate-dictionary-configuration-to-supabase.mjs",
    "migrate:attachments": "node scripts/migrate-attachments-to-supabase.mjs",
    "migrate:audit-logs": "node scripts/migrate-audit-logs-to-supabase.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@pureadmin/utils": "^1.4.0",
    "dayjs": "^1.11.6",
    "dotenv": "^16.0.3",
    "fastify": "^5.0.0",
    "jsonwebtoken": "^8.5.1",
    "mysql2": "^3.11.0",
    "svg-captcha": "^1.4.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^8.5.9",
    "@types/node": "^20.19.23",
    "nodemon": "^2.0.20",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
