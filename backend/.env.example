# Port
PORT=3000

# JWT_SECRET：仅用于本地开发，生产环境使用安全随机值
JWT_SECRET=replace-with-a-local-secret

# Token TTL
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=7

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_DATABASE=admin_template

# Temporary auth bridge: validate Supabase sessions and resolve the caller's
# business user ID for existing Fastify/MySQL modules. Publishable key is public.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-local-value

# Debug
LOG_LEVEL='debug'
