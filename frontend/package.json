{
  "name": "fullstack-admin-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "volta": {
    "node": "24.18.0",
    "pnpm": "12.3.4"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 vite",
    "serve": "pnpm dev",
    "build": "rimraf dist && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:staging": "rimraf dist && vite build --mode staging",
    "report": "rimraf dist && vite build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit --skipLibCheck",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "node scripts/run-local-auth-e2e.mjs",
    "test:e2e:local": "node scripts/run-local-auth-e2e.mjs",
    "test:db": "node scripts/test-local-database.mjs",
    "supabase:start": "supabase --workdir .. start",
    "supabase:status": "supabase --workdir .. status",
    "supabase:stop": "supabase --workdir .. stop",
    "supabase:db:reset": "supabase --workdir .. db reset --local"
  },
  "keywords": [
    "vue3",
    "vite",
    "shadcn-vue",
    "tailwindcss",
    "vueuse",
    "admin"
  ],
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@supabase/supabase-js": "^2.117.2",
    "@template/contracts": "workspace:*",
    "@vueuse/core": "^14.0.0",
    "@vueuse/motion": "^3.0.3",
    "animate.css": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.18",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.3",
    "pinyin-pro": "^3.27.0",
    "reka-ui": "^2.10.5",
    "responsive-storage": "^2.2.0",
    "sortablejs": "^1.15.6",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@iconify/json": "^2.2.400",
    "@iconify/vue": "4.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^24.19.1",
    "@types/nprogress": "^0.2.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.1",
    "boxen": "^8.0.1",
    "code-inspector-plugin": "^1.2.10",
    "cssnano": "^7.1.1",
    "gradient-string": "^3.0.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-load-config": "^6.0.1",
    "postcss-scss": "^4.0.9",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass": "^1.93.2",
    "supabase": "2.119.0",
    "svgo": "^4.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "unplugin-icons": "^22.5.0",
    "vite": "^7.1.12",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-remove-console": "^2.2.0",
    "vite-plugin-router-warn": "^1.0.0",
    "vite-svg-loader": "^5.1.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9"
  }
}
